{
  "name": "iquesters/user-interface",
  "description": "A modern, reusable, and customizable UI interface built for creating clean and responsive user experiences. Designed with simplicity, scalability, and flexibility in mind.",
  "type": "library",
  "require": {
    "php": ">=8.1",
    "laravel/framework": "^10.0|^11.0|^12.0|^13.0",
    "iquesters/foundation": "^1.0",
    "diglactic/laravel-breadcrumbs": "^10.0"
  },
  "suggest": {
    "iquesters/user-management": "Login, per-user theme and the sanctum token used by the in-app API client",
    "spatie/laravel-permission": "Role checks (setup link, admin-only routes)"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0|^11.0",
    "laravel/sanctum": "^4.0",
    "spatie/laravel-permission": "^6.16"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../foundation",
      "options": { "symlink": true, "versions": { "iquesters/foundation": "1.x-dev" } }
    }
  ],
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Iquesters\\UserInterface\\": "src/",
      "Iquesters\\UserInterface\\Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Iquesters\\UserInterface\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "authors": [
    {
      "name": "Pritam Bag",
      "email": "pritam02b@gmail.com"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "extra": {
    "laravel": {
      "providers": [
        "Iquesters\\UserInterface\\UserInterfaceServiceProvider"
      ]
    }
  }
}